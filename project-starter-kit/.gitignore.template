# Local secrets
.env
.env.*
!.env.example

# Private source material (raw transcripts, unsanitized notes)
.private/

# Local verification evidence (remove this rule if evidence should be committed)
ui-evidence/

# Generated brand packages can contain large images, PDFs, fonts, and archives.
# Keep the policy README; move selected production assets elsewhere or adopt
# explicit Git LFS/size rules before tracking them.
brand/generated/**
!brand/generated/README.md

# Scratch output from local scripts and one-off experiments
local-artifacts/
tmp/

# Common generated output; tailor to project
node_modules/
dist/
build/
coverage/

